<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>ProWrestlingRevolution</AssemblyName>
    <ApplicationTitle>Pro Wrestling Revolution</ApplicationTitle>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />
    <Content Include="Data/Scenarios/Genesis.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always"/>
  </ItemGroup>
</Project>
