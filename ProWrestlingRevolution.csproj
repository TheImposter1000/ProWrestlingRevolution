<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Use the same Windows DPI virtualization convention as older desktop sims.
         Logical layout stays 1366 x 768; Windows scales its apparent physical size
         to the user's display setting instead of shrinking the fixed-size artwork. -->
    <ApplicationHighDpiMode>DpiUnawareGdiScaled</ApplicationHighDpiMode>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>ProWrestlingRevolution</AssemblyName>
    <ApplicationTitle>Pro Wrestling Revolution</ApplicationTitle>
    <!-- Prefer a portable project-relative icon. Retain the existing local
         custom icon when building from its original installation directory. -->
	  <ApplicationIcon>System\ProWrestlingRevolution-Final-AppIcon.ico</ApplicationIcon>
    <Version>0.5.25</Version>
    <AssemblyVersion>0.5.25.0</AssemblyVersion>
    <FileVersion>0.5.25.0</FileVersion>
  </PropertyGroup>
  <ItemGroup>
    <!-- The separate metadata MDB is generated before release/CI builds.
         A local development build without this optional file uses raw labels. -->
    <EmbeddedResource Include="System/PRWEditor.mdb"
                      LogicalName="PRWEditor.mdb"
                      Condition="Exists('System/PRWEditor.mdb')" />
    <Content Include="System/PRWEditor.mdb"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="Always"
             Condition="Exists('System/PRWEditor.mdb')" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.Data.OleDb" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Skins/**/*.jpg;Skins/**/*.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    <Content Include="System/README.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    <Content Include="Pictures/README.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    <Content Include="Databases/README.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
  </ItemGroup>
</Project>